<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/timer_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/task_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/timer_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:progress="100"
                app:indicatorSize="260dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:trackCornerRadius="8dp"
                app:trackThickness="16dp" />

            <TextView
                android:id="@+id/session_type_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Focus Time"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintBottom_toTopOf="@id/time_text"
                app:layout_constraintEnd_toEndOf="@id/timer_progress"
                app:layout_constraintStart_toStartOf="@id/timer_progress"
                app:layout_constraintTop_toTopOf="@id/timer_progress"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="25:00"
                android:textColor="?attr/colorPrimary"
                android:textSize="56sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/session_text"
                app:layout_constraintEnd_toEndOf="@id/timer_progress"
                app:layout_constraintStart_toStartOf="@id/timer_progress"
                app:layout_constraintTop_toBottomOf="@id/session_type_text" />

            <TextView
                android:id="@+id/session_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Session 1 of 4"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="@id/timer_progress"
                app:layout_constraintEnd_toEndOf="@id/timer_progress"
                app:layout_constraintStart_toStartOf="@id/timer_progress"
                app:layout_constraintTop_toBottomOf="@id/time_text" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Task row -->
    <LinearLayout
        android:id="@+id/task_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timer_card"
        app:layout_constraintBottom_toTopOf="@id/streak_text">

        <TextView
            android:id="@+id/active_task_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Working on:"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/active_task_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Task"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_task_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="Clear"
            android:textColor="?attr/colorError"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/streak_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Longest Streak: 0"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_row"
        app:layout_constraintBottom_toTopOf="@id/today_stats_text" />

    <TextView
        android:id="@+id/today_stats_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Today: 0 pomodoros"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/streak_text"
        app:layout_constraintBottom_toTopOf="@id/daily_goal_progress" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/daily_goal_progress"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/today_stats_text"
        app:layout_constraintBottom_toTopOf="@id/daily_goal_text"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/daily_goal_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Goal: 0 / 8"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/daily_goal_progress"
        app:layout_constraintBottom_toTopOf="@id/start_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_button"
        android:layout_width="220dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:text="Start"
        android:textSize="20sp"
        app:cornerRadius="36dp"
        app:layout_constraintBottom_toTopOf="@id/skip_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/daily_goal_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="Skip"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toTopOf="@id/reset_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/start_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reset"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skip_button" />

    <com.example.student_pomodoro.ConfettiView
        android:id="@+id/confetti_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
